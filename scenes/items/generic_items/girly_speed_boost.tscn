legal_text = "[center][b][color=#D08770]SPEEDBURST™ GIRL EDITION™[/color][/b][/center]
[center][i]Comprehensive License of Empowerment, Subjection, Monetization, and Gendered Acceleration (CL-ESMGA) v47.113b[/i][/center]
