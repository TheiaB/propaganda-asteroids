[node name="basic_laserbeam" type="Node"]
script = ExtResource("1_hoi5b")
title = "Laserbeam"
price = 299
description = "The LazeRazor™ fires a sustained laser beam after a mandatory charge, delivering continuous damage over time.  Stay perfectly still, focus, and watch your enemies melt — just remember, immobility comes at a cost."
video = ExtResource("2_hoi5b")
unique_name = "laser_railgun"
legal_text = "[center][b][color=#88C0D0]THE LAZERAZOR™[/color][/b][/center]
[center][i]Continuous Beam Weapon Usage, Charge, and Liability Framework (CBWULF) v9.01[/i][/center]
---------------
[color=#777777][i]User acknowledges inherent risks associated with prolonged charge and sustained beam operation.[/i][/color]
---------------
[b]1. EQUIPMENT SUMMARY:[/b]  
The LazeRazor™ emits a continuous energy beam after mandatory charge, persisting for several seconds post-discharge.
---------------
[b]2. CHARGE AND VULNERABILITY:[/b]  
User is fully immobilized during charge, with elevated exposure risk to hostile entities and environmental hazards.
---------------
[b]3. BEAM CHARACTERISTICS:[/b]  
The beam inflicts continuous damage along its length and duration, with potential collateral impact.
---------------
[b]4. FINANCIAL TERMS:[/b]  
Includes:
• Base Acquisition Cost  
• Prolonged Exposure Liability Fee  
• Collateral Damage Insurance (optional, highly recommended)  
---------------
User assumes responsibility for all damage, including friendly fire and structural destabilization.
---------------
[b]5. WARRANTY DISCLAIMERS:[/b]  
No guarantees on beam stability, duration, or enemy response time. Prolonged use may result in user exhaustion or spatial disorientation.
---------------
[quote][i]Caution: Prolonged beam exposure may cause unintentional self-reflection.[/i][/quote]
---------------
[center][color=#88C0D0][b]LazeRazor™: Precision destruction with a side of enforced stillness.[/b][/color][/center]"
